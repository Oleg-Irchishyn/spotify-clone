# HTTP is used ONLY to serve uploaded picture/audio files (ServeStaticModule) —
# the actual tracks/albums API is TCP-only, reachable exclusively through
# api-gateway. This port is what api-gateway/clients load images/audio from
# directly (same idea as the monolith's existing R2 URLs — an absolute URL
# that isn't proxied through the gateway at all).
HTTP_PORT=4002
PUBLIC_URL=http://localhost:4002

# TCP port for the @MessagePattern RPC surface — only api-gateway connects here.
TCP_PORT=4012

# A database this service owns exclusively — separate from auth-service's and
# from the main server/'s monolith db. E.g. reuse the same Atlas cluster with
# a fresh db name like "spotify_catalog_ms".
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/spotify_catalog_ms
