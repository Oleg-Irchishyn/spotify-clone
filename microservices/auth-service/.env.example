# TCP port this service listens on — only the api-gateway ever connects here.
TCP_PORT=4001

# A database this service owns exclusively. Point it at a *different* db name
# than catalog-service (and than the main server/'s monolith db) — e.g. reuse
# the same Atlas cluster with a fresh db name like "spotify_auth_ms".
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/spotify_auth_ms

# Must be the EXACT same value as api-gateway's PRIVATE_KEY — auth-service
# signs tokens with it, api-gateway verifies them with it. This shared secret
# is the trust boundary between the two.
PRIVATE_KEY=<a-long-random-string>
