# The only public port in this sandbox.
PORT=4000
CLIENT_URL=http://localhost:3000

# Must be the EXACT same value as auth-service's PRIVATE_KEY — the gateway
# verifies JWTs signed by auth-service itself, with no network round-trip.
PRIVATE_KEY=<a-long-random-string>

AUTH_SERVICE_HOST=localhost
AUTH_SERVICE_PORT=4001

CATALOG_SERVICE_HOST=localhost
CATALOG_SERVICE_PORT=4012
