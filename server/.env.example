# Copy this file to both .development.env and .production.env, then fill
# in real values (they'll typically differ between the two — e.g. a
# different CLIENT_URL/MONGO_URI for production).

PORT=5000
SERVER_URL=http://localhost:5000
CLIENT_URL=http://localhost:3000
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<db-name>
PRIVATE_KEY=<your-jwt-signing-secret>

# Cloudflare R2 — only read when NODE_ENV=production (see README).
# Not needed in .development.env; uploads there stay on local disk.
R2_ACCOUNT_ID=<your-cloudflare-account-id>
R2_ACCESS_KEY_ID=<your-r2-access-key-id>
R2_SECRET_ACCESS_KEY=<your-r2-secret-access-key>
R2_BUCKET_NAME=<your-r2-bucket-name>
R2_PUBLIC_URL=https://pub-xxxxxxxxxxxxxxxx.r2.dev
